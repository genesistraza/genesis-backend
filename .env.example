# Base de datos (Railway o Supabase te la dan al crear el proyecto)
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos

# Seguridad de sesiones (invéntate una cadena larga y aleatoria, no la compartas)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Resend (para enviar el código de verificación por correo) - resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Genesis Traza <no-reply@genesis-traza.com>

# Wompi (pasarela de pagos) - comercios.wompi.co
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxx
WOMPI_EVENTS_SECRET=prod_events_xxxxxxxxxxxx

PORT=3000
